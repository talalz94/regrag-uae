# Copy to .env and fill in only what you use. Never commit .env.
# Load it with: uv run --env-file .env regrag ...
# Retrieval and evals need none of these. They are for the answer slice.

# none | openai | azure | ollama
REGRAG_LLM_PROVIDER=none
# Model name. On Azure this is your deployment name.
REGRAG_LLM_MODEL=

# openai: OpenAI, or any server with the same API
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# azure: Azure OpenAI in Azure AI Foundry, for example https://my-resource.openai.azure.com
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=

# ollama: local server, no key
OLLAMA_BASE_URL=http://localhost:11434/v1

# Where ObliQA and the embedding cache live (default: ./data)
REGRAG_DATA_DIR=data
